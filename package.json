{
  "name": "playwright-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "cucumber-js --config cucumber.json",
    "test:headed": "cross-env HEADED=1 cucumber-js --config cucumber.json",
    "test:ci": "PLAYWRIGHT_BROWSERS_PATH=0 CI=true cucumber-js --config cucumber.json",
    "browsers": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright install chromium",
    "pw:install": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright install",
    "allure:generate": "npx allure generate ./allure-results --clean",
    "allure:open": "npx allure open ./allure-report",
    "docker:build": "docker compose build e2e",
    "test:docker": "docker compose run --rm e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@cucumber/cucumber": "^12.5.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "allure": "^3.7.0",
    "allure-cucumberjs": "^3.3.0",
    "allure-js-commons": "^3.7.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2"
  }
}
