# Optional (copy to .env)
# SAUCE_DEMO_URL=https://www.saucedemo.com
# SAUCE_STANDARD_PASSWORD=secret_sauce
# DEFAULT_TIMEOUT=15000
# HEADED=1
# SLOW_MO=300              # Playwright slowMo (ms) between actions — use for debugging
# PW_SLOW_MO=300           # alias for SLOW_MO
# BROWSER=chromium
# VIEWPORT_WIDTH=1280
# VIEWPORT_HEIGHT=720
# MIN_BACKTRACE_TELEMETRY_FAILURE_STATUS=500   # strict 5xx only (default 400 so public saucedemo 401 passes)
